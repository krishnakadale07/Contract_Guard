{
  "name": "@krishnakadale07/contractguard",
  "version": "0.2.0",
  "description": "Detect breaking OpenAPI changes and validate live API contracts locally and in CI.",
  "license": "MIT",
  "keywords": [
    "openapi",
    "api",
    "contract-testing",
    "api-testing",
    "breaking-changes",
    "cli",
    "github-actions"
  ],
  "type": "module",
  "bin": {
    "contractguard": "./bin/contractguard.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/cli/index.ts",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "files": [
    "bin",
    "dist",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/krishnakadale07/ContractGaurd.git"
  },
  "bugs": {
    "url": "https://github.com/krishnakadale07/ContractGaurd/issues"
  },
  "homepage": "https://github.com/krishnakadale07/ContractGaurd#readme",
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "commander": "^12.1.0",
    "js-yaml": "^4.1.0"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.10.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  },
  "engines": {
    "node": ">=18"
  }
}
